# ============================================
# Cofrin - Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA versione o .env com valores reais.

# --- Banco de Dados ---
DATABASE_URL=postgresql://cofrin:SENHA_SEGURA@db:5432/cofrin?schema=public
POSTGRES_USER=cofrin
POSTGRES_PASSWORD=SENHA_SEGURA
POSTGRES_DB=cofrin

# --- JWT / Auth ---
JWT_SECRET=gere_um_segredo_forte_aqui
JWT_REFRESH_SECRET=gere_outro_segredo_forte_aqui
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Cloudflare Turnstile ---
TURNSTILE_SITE_KEY=0x4AAAAAADWxcIYnIuEowhAf
TURNSTILE_SECRET_KEY=sua_secret_key_aqui

# --- Resend (e-mail transacional) ---
RESEND_API_KEY=sua_api_key_aqui
RESEND_FROM_EMAIL=Cofrin <noreply@gestaofinanceira.codermaster.com.br>

# --- Web Push (VAPID) ---
VAPID_PUBLIC_KEY=gere_chave_publica_vapid
VAPID_PRIVATE_KEY=gere_chave_privada_vapid
VAPID_SUBJECT=mailto:contato@codermaster.com.br

# --- App ---
APP_URL=https://gestaofinanceira.codermaster.com.br
API_URL=https://gestaofinanceira.codermaster.com.br/api
PORT=3000
NODE_ENV=production

# --- Uploads ---
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE=5242880
